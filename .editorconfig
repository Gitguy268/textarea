# Two spaces, no semicolons, single quotes, trailing commas. npm run lint checks
# correctness only, so this file and CONTRIBUTING.md are what keep the files
# looking like each other.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, and the README uses them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
